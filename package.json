{
  "private": true,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('output', { recursive: true, force: true })\"",
    "build": "npm run lint && spago build --pedantic-packages --strict",
    "test": "spago test --pedantic-packages --strict",
    "lint": "oxlint src test",
    "fmt": "purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs' && oxfmt --write 'src/**/*.js'",
    "fmt:check": "purs-tidy check src test && oxfmt --check 'src/**/*.js'"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purescript": "0.15.15",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4"
  }
}
