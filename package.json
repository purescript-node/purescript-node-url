{
  "private": true,
  "scripts": {
    "clean": "rimraf output && rimraf .pulp-cache",
    "build": "npm run lint && pulp build -- --censor-lib --strict",
    "test": "pulp test -- --censor-lib --strict",
    "lint": "oxlint src test",
    "fmt": "purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs' && oxfmt --write 'src/**/*.js'",
    "fmt:check": "purs-tidy check src test && oxfmt --check 'src/**/*.js'"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "pulp": "16.0.0-0",
    "purescript": "0.15.15",
    "purescript-psa": "^0.8.2",
    "purs-tidy": "0.11.1",
    "rimraf": "^3.0.2"
  }
}
